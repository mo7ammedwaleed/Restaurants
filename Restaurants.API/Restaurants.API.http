@host = https://localhost
@port = 7115
@Restaurants.API_HostAddress = https://localhost:7115


GET {{Restaurants.API_HostAddress}}/api/restaurants

###

GET {{Restaurants.API_HostAddress}}/api/restaurants/{restaurantId}

###

GET {{Restaurants.API_HostAddress}}/api/restaurants/{restaurantId}/dishes

###

GET {{Restaurants.API_HostAddress}}/api/restaurants/{restaurantId}/dishes/{dishId}

###

POST {{Restaurants.API_HostAddress}}/api/restaurants
Content-Type: application/json
{
      "Name": "Owner2 restaurant2",
      "Description": "A cozy restaurant serving a variety of delicious dishes.",
      "Category": "Indian",
      "HasDelivery": true,
      "ContactEmail": "info@test.com",
      "ContactNumber": "555-1234",
      "City": "New York",
      "Street": "123 Main Street",
      "PostalCode": "10-010"
}

###

DELETE {{Restaurants.API_HostAddress}}/api/restaurants/{restaurantId}

###


PATCH {{Restaurants.API_HostAddress}}/api/restaurants/{restaurantId}
Content-Type: application/json

{
  "Name": "Sample Patch",
  "Description": "A cozy restaurant serving a variety of delicious dishes.",
  "HasDelivery": true
}

###


POST {{Restaurants.API_HostAddress}}/api/restaurants/{restaurantId}/dishes
Content-Type: application/json

{
  "Name": "Pasta",
  "Description": "Delicious pasta with tomato sauce",
  "Price": 25,
  "KiloCalories": 15
}

